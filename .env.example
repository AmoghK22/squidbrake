# Everything here is OPTIONAL. The gateway runs fine with no .env at all.
# To use: copy to .env and uncomment what you need.

# --- Notifications: ping a Slack/Mattermost/Discord-style webhook when something needs approval
# APPROVAL_WEBHOOK_URL=https://hooks.slack.com/services/...
# PUBLIC_URL=https://gateway.example.com      # so messages link straight to the event

# --- Behaviour
# APPROVAL_TIMEOUT=300       # seconds a held call waits for a human (rules can override)
# RETENTION_DAYS=0           # delete history older than this; 0 = keep forever
# MAX_PAYLOAD_CHARS=65536    # longer inputs/outputs are truncated in storage
# PROXY_TIMEOUT=60
# LOG_LEVEL=INFO

# --- Server
# PORT=8080
# HOST=127.0.0.1             # 0.0.0.0 to accept connections from other machines (Docker does this)
# WORKERS=1

# --- Storage (default: SQLite in ./data). Use Postgres for several gateway replicas:
# DATABASE_URL=postgresql+psycopg://gateway:pass@db:5432/gateway

# --- Keys. By default they are created on first start and managed with
#     `python server.py add-key NAME [--approver]`. Only set these to manage keys yourself:
# GATEWAY_API_KEYS=agent-a:secret1,alice:secret2
# GATEWAY_APPROVERS=alice
# READ_ONLY_KEYS=auditor,visitor   # these keys can look but never change anything (e.g. a public demo key)
# GATEWAY_AUTH=off           # disables authentication entirely - local experiments only
